#!/bin/bash
# Runs once, on the first boot of a new appliance copy.
set -euo pipefail
ENV=/etc/sz-ai-noc.env; DATA=/var/lib/sz-ai-noc
ssh-keygen -A >/dev/null 2>&1 || true
if [ ! -f "$ENV" ]; then
  umask 027
  KEY=$(head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 22)
  printf 'NOC_ADMIN_KEY=%s\n' "$KEY" > "$ENV"; chgrp szai "$ENV"
fi
sz-ai-noc-cert || echo "certificate generation failed — HTTPS can be set up later in the editor"
touch "$DATA/.provisioned"; chown szai:szai "$DATA/.provisioned"
/usr/local/sbin/sz-ai-noc-banner || true
